# AquaSentinel-AI Production Environment Variables Template
# Copy this file to .env and populate with deployment secrets.
# DO NOT commit real secrets or credentials to source control.

# Wi-Fi Credentials
AQUA_WIFI_SSID=AquaNet_Freshwater_AP
AQUA_WIFI_PASSWORD=YOUR_SECURE_WIFI_PASSWORD_HERE

# MQTT Broker Configuration & Credentials
AQUA_MQTT_HOST=localhost
AQUA_MQTT_PORT=1883
AQUA_MQTT_USERNAME=aquasentinel_gateway
AQUA_MQTT_PASSWORD=YOUR_SECURE_MQTT_PASSWORD_HERE

# System & Deployment Environment
AQUA_ENV=production
AQUA_DEVICE_ID=AQUA_FRESH_001
AQUA_DATASET_ROUTE=caml
