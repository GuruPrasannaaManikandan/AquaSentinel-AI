{
    "random_seed": 42,
    "caml": {
        "train_path": "data/processed/caml_train.csv",
        "val_path": "data/processed/caml_val.csv",
        "test_path": "data/processed/caml_test.csv",
        "features": ["lat", "lon", "distance_to_water_m", "region", "Season", "Year", "Month_sin", "Month_cos", "DayOfYear_sin", "DayOfYear_cos"],
        "target": "severity",
        "hyperparameters": {
            "logistic_regression": {
                "C": 1.0,
                "max_iter": 1000,
                "multi_class": "multinomial",
                "solver": "lbfgs"
            },
            "decision_tree": {
                "max_depth": 8,
                "min_samples_split": 5,
                "criterion": "gini"
            },
            "random_forest": {
                "n_estimators": 100,
                "max_depth": 12,
                "min_samples_split": 5,
                "n_jobs": -1
            },
            "hist_gradient_boosting": {
                "max_iter": 100,
                "max_depth": 8,
                "learning_rate": 0.1
            }
        }
    },
    "habsos": {
        "train_path": "data/processed/habsos_train.csv",
        "val_path": "data/processed/habsos_val.csv",
        "test_path": "data/processed/habsos_test.csv",
        "features": ["LATITUDE", "LONGITUDE", "STATE_ID", "SAMPLE_DEPTH", "SALINITY", "WATER_TEMP", "Season", "Year", "Month", "Month_sin", "Month_cos", "DayOfYear_sin", "DayOfYear_cos"],
        "target": "CATEGORY",
        "hyperparameters": {
            "logistic_regression": {
                "C": 1.0,
                "max_iter": 1000,
                "multi_class": "multinomial",
                "solver": "lbfgs"
            },
            "decision_tree": {
                "max_depth": 10,
                "min_samples_split": 5,
                "criterion": "gini"
            },
            "random_forest": {
                "n_estimators": 100,
                "max_depth": 14,
                "min_samples_split": 5,
                "n_jobs": -1
            },
            "hist_gradient_boosting": {
                "max_iter": 100,
                "max_depth": 8,
                "learning_rate": 0.1
            }
        }
    }
}
